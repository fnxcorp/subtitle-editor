{
  "name": "subtitle-editor",
  "version": "1.0.0",
  "private": true,
  "description": "Local subtitle editor: edit SRT/VTT subtitles in sync with a video, with quality checks, transcription and translation",
  "main": "build/src/desktop/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.web.json && tsc -p tsconfig.node.json",
    "start": "npm run build && node build/src/server/server.js",
    "app": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "node --test test/unit.test.mts",
    "test:e2e": "npm run build && electron build/test/e2e.js",
    "check": "npm run typecheck && npm run lint && npm test",
    "dist": "npm run build && npx --yes electron-builder@26.17.0 --mac --win"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.4",
    "electron": "44.7.0",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  },
  "build": {
    "appId": "local.subtitle-editor",
    "productName": "Editor de subtítulos",
    "files": [
      "build/src/**",
      "public/**",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": [
          "srt",
          "vtt"
        ],
        "name": "Subtítulos",
        "role": "Editor"
      },
      {
        "ext": [
          "mp4",
          "mov",
          "mkv",
          "m4v",
          "webm"
        ],
        "name": "Vídeo",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "mac": {
      "category": "public.app-category.video"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fnxcorp/subtitle-editor.git"
  },
  "engines": {
    "node": ">=26.11"
  },
  "author": "fnxcorp"
}
